clearvars -except u y

%% 2.1.1 FIR model identification
[y, u, Ts] = GetExperimentData('data.m');

% u, y are column vectors
u = u(:);
y = y(:);

% FIR model settings
m = 200;
d = 1;

% Basic size check
N = length(u);
if length(y) ~= N
    error('u and y must have the same length.');
end

%Make each row to 200 inputs
first_col = u(m:N-1);
first_row = u(m:-1:1);
Phi = toeplitz(first_col, first_row);

y_used = y(m+1:N); % follow conditions of FIR
%1
theta_hat = (Phi'*Phi)\(Phi'*y_used); % Least-square solution

%2
y_hat = Phi * theta_hat;
prediction_error = y_used - y_hat;
J = sum(prediction_error.^2);
% Plot measured output and predicted output
k=(m+1:N); %defined for only used indexes; toeplitz
figure;
plot(k, y_used, 'b');
hold on;
plot(k, y_hat, 'r');
legend('True y', 'Estimated y')
hold off;

xlabel('index m+1 to N');
ylabel('output Y');
title('2.1.1 Measured output and predicted output');
grid on;
% Display the loss function
fprintf('2.1.1 Loss function J(theta_hat) = %.6f\n', J);

%3
% Estimate noise variance
sigma_sq_hat = J / ((N-m)-m); %N-m is #of data actually used
cov_theta_hat = sigma_sq_hat *inv(Phi'*Phi);

theta_std = sqrt(diag(cov_theta_hat)); %compute the lenght of interval (σ)
%plot
figure;
errorbar(1:m, theta_hat, 2*theta_std, 'o');
xlabel('Coefficient index(m)');
ylabel('Estimated FIR');
title('FIR with ±2σ confidence interval');
grid on;


%% 2.1.2 ARX model identification

N = length(u);
Phi = [-y(2:N-1), -y(1:N-2), u(2:N-1), u(1:N-2)]; %k=3,4,...N
y_used = y(3:N);
%1
theta_hat = (Phi'*Phi)\(Phi'*y_used);

%print parameters
fprintf('2.1.2-1 theta_hat = %g\n', theta_hat);

fprintf('a1 = %.4f\n', theta_hat(1));
fprintf('a2 = %.4f\n', theta_hat(2));
fprintf('b1 = %.4f\n', theta_hat(3));
fprintf('b2 = %.4f\n', theta_hat(4));

%2
y_hat = Phi * theta_hat;
prediction_error = y_used - y_hat;
J = sum(prediction_error.^2);
fprintf('2.1.2-2 Loss function J = %.6f\n', J);

% Plot measured output and predicted output
k = (3:N)';
figure;
plot(k, y_used, 'b', 'LineWidth',1.5);
hold on;
plot(k, y_hat, 'r');
hold off;
title('2.1.2-2 Measured output and predicted output');
grid on;
legend('Measured output (y\_used)', 'Predicted output (y\_hat)');

%3
t = (0:N-1)' * Ts; %time vector; generated for lsim
sys_hat = tf([0 theta_hat(3) theta_hat(4)], [1 theta_hat(1) theta_hat(2)], Ts);
y_m = lsim(sys_hat, u, t);
y_m_used = y_m(3:N); %can only compare from k=3

figure;
plot(k, y_used, 'b');
hold on;
plot(k, y_m_used, 'r');
hold off;
title('2.1.2-3 Measured output y and y_m');
grid on;
legend('Measured output (y\_used)', 'Simulated output (y\_m\_used)');

error = y_used - y_m_used;
error_norm = norm(error, 2);
fprintf('2.1.2-3 Two-norm of the error = %.6f\n', error_norm);

%4 Instrumental Variable method

Phi_iv = [-y_m(k-1), -y_m(k-2), u(k-1), u(k-2)];
theta_iv = (Phi_iv'*Phi)\(Phi_iv'*y_used);
y_hat_iv = Phi * theta_iv; %use this bc we need to use same model structure
J_iv = sum((y_used - y_hat_iv).^2);

%print parameters
fprintf('theta_iv = %g\n', theta_iv);

%plot and compare
figure;
plot(k, y_used, 'b','LineWidth',1.5);
hold on;
plot(k, y_m_used, 'g');
plot(k, y_hat_iv, 'r');
hold off;
title('2.1.2-4 Comparision of ARX result and Instrumental Variable method');
grid on;
legend('Measured output (y\_used)','ARX model output (y\_m\_used)', 'IV model output (y\_hat\_iv)');

fprintf('J_iv = %.6f\n', J_iv); %Shall we compare the J too? How to show??
%Difference of J

%% 2.1.3 State-space model identification
%1
N = length(u);
r = 25; %random value
L = N-r+1; %number of columns

Y = zeros(r, L);
U = zeros(r, L);

for k = 1:L
    Y(:,k) = y(k:k+r-1);
    U(:,k) = u(k:k+r-1);
end

U_perp = eye(L) - U'*((U*U')\U);
Q = Y*U_perp;

%2
[UU, S, V] = svd(Q);
sing_values = diag(S);

%plot singular values of Q
figure;
plot(diag(S), 'o-');
grid on;
title('2.1.3 -2 Plot of singular values of Q');
n = 5; %Compute manually by diag(S); height difference start to change
Or = UU(:,1:n);

%3
n_y = 1; %system is SISO 
C = Or(1:n_y,:); 

Or_first = Or(1:r-1,:);
Or_last = Or(2:r,:);
A = Or_first \ Or_last;

%give values of A and C
fprintf()
%4
Phi_B = zeros(N,n);
for i = 1:n
    e = zeros(n,1);
    e(i)=1;

    F_i = ss(A,e,C,0,Ts);
    Phi_B(:,i) = lsim(F_i, u, t);
end

B = (Phi_B'*Phi_B)\(Phi_B'*y); 

%5
SS_hat = ss(A,B,C,0,Ts);
y_m = lsim(SS_hat, u, t);

error = y - y_m;
error_norm = norm(error, 2);

figure;
plot(t, y,'b');
plot(t, y_m, 'r');
grid on;
xlabel('Time [s]');
ylabel('Output');
title('2.1.3 Measured Output y vs State-Space Model Output y_m');

fprintf('two norm of the error = %.6f\n', error_norm);